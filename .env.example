# Copy to .env and fill in. Nothing here is read automatically — the CLI reads these
# from the process environment, so export them or use your own dotenv loader.

# Key used to seal the event log (`python -m sentinel seal`). Hold it OUTSIDE the log:
# the seal only proves anything if whoever can write the log cannot compute the MAC.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FRAUDSHIELD_SEAL_KEY=

# Structured-log verbosity for the JSON lines written to stderr.
# One of DEBUG, INFO, WARNING, ERROR. Defaults to WARNING.
FRAUDSHIELD_LOG_LEVEL=WARNING
